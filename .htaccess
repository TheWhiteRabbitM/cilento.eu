# GoCilento — hosting Apache (IONOS e simili)
# Niente routing applicativo: il sito è file statici, gli URL /it/ /en/ /de/
# si risolvono da soli come directory.

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS sempre (se l'hosting lo gestisce già, questa regola è ininfluente)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Pagina 404 trilingue
ErrorDocument 404 /404.html

# Compressione testi e JSON
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache
# Attenzione: styles.css e app.js NON hanno il nome versionato (niente build,
# vedi ADR-001). Con "access plus 1 month" un restyle restava invisibile ai
# visitatori ritornanti per trenta giorni. Qui quindi CSS e JS non vengono
# mai considerati freschi: il browser li riverifica e riceve un 304 se sono
# invariati (costano 70 KB gzip, non un problema).
# Le immagini invece restano in cache lunga: se ne cambi una, rinomina il file.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>

# Header di sicurezza conservativi (niente CSP: abbiamo SVG e style inline)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HTML, CSS, JS e JSON: sempre riverificati, mai serviti dalla cache
  <FilesMatch "\.(html|json|txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
  # Font: stabili per nome, cache lunga
  <FilesMatch "\.(woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
